# ─────────────────────────────────────────────────────────────────
# App (FastAPI)
# ─────────────────────────────────────────────────────────────────
APP_NAME=algo-trading-ingester
APP_HOST=0.0.0.0
APP_PORT=8090
# Identifies this process in every event (source.ingester_id) and every
# Telegram message. Blank = the machine's hostname.
APP_INSTANCE_ID=
# Comma-separated gateways to start: mt5 (binance once implemented)
APP_GATEWAYS=mt5
# Swagger /docs, /redoc and /openapi.json
APP_DOCS_ENABLED=false

# ─────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ─────────────────────────────────────────────────────────────────
# NATS — publish only, the ingester never subscribes
# Subjects: <NATS_SUBJECT_PREFIX>.bar.closed.<gateway>.<symbol>.<timeframe>
#   e.g.     INGEST.bar.closed.mt5.XAUUSD.M15
# Dots and other unsafe characters in a symbol become "_" in the subject only
# (XAUUSD.m → XAUUSD_m); the JSON payload keeps the symbol verbatim.
# ─────────────────────────────────────────────────────────────────
NATS_HOST=localhost
NATS_PORT=4222
NATS_TOKEN=changeme
NATS_SUBJECT_PREFIX=INGEST
NATS_CONNECT_TIMEOUT=5.0
NATS_RECONNECT_TIME_WAIT=2.0
# false = core NATS (fire-and-forget). true = JetStream: every bar is persisted
# on NATS_STREAM_NAME (created if missing, never reconfigured) and de-duplicated
# by event_id via Nats-Msg-Id. The server must run with JetStream (-js).
NATS_JETSTREAM_ENABLED=false
NATS_STREAM_NAME=INGEST
NATS_PUBLISH_TIMEOUT=5.0
NATS_STREAM_MAX_AGE_SECONDS=604800
# Must cover the span MT5_BACKFILL_ON_START can replay, or a restart
# republishes bars the subscriber has already seen. Fixed when the stream is
# created; an existing stream is never reconfigured.
NATS_DUPLICATE_WINDOW_SECONDS=120

# ─────────────────────────────────────────────────────────────────
# Telegram — service status notifications (running / stopped / gateway
# connected / disconnected / NATS disconnected / reconnected)
# TELEGRAM_CHAT_IDS is comma-separated; append "_<topic id>" to post into a
# forum topic, e.g. "-1001111111111,-1002173777783_924584".
# ─────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_HTTP_TIMEOUT=5.0
TELEGRAM_QUEUE_SIZE=100
# Mirror every ERROR log record into its own chat, so a failure is not buried
# between the lifecycle messages. Needs TELEGRAM_ENABLED=true as well.
TELEGRAM_LOG_ERRORS_ENABLED=false
# Both fall back to TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_IDS when left blank, so
# a separate token is only needed when the error chat belongs to another bot.
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_IDS=
# Seconds an identical error is suppressed: a failing poll repeats every
# interval and would otherwise flood the chat.
TELEGRAM_LOG_DEDUP_WINDOW=60

# ─────────────────────────────────────────────────────────────────
# MetaTrader 5 gateway (Windows only — needs a running MT5 terminal)
# ─────────────────────────────────────────────────────────────────
# Name the bare instrument. The gateway asks the terminal what this broker
# calls it (Exness sells XAUUSD as XAUUSDm) and reads bars from that name, but
# publishes the name written here — so event_id survives a change of broker.
# A fully-spelled name (XAUUSDm) is still used verbatim.
MT5_SYMBOLS=XAUUSD,EURUSD
# Forces the broker's affix when auto-detection finds several equally close
# candidates, e.g. EURUSDm vs EURUSDc. Blank = detect it per symbol.
MT5_SYMBOL_SUFFIX=
# Any of: M1,M5,M15,M30,H1,H4,D1,W1
MT5_TIMEFRAMES=M1,M15,H1
# forex | cfd | crypto — copied into every event's source.market
MT5_MARKET=forex
# Path to terminal64.exe; blank = let the MetaTrader5 package find it
MT5_TERMINAL_PATH=
# Leave LOGIN/PASSWORD/SERVER blank to use the account the terminal is logged in
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000
# MT5 bar times are in trade-server time. Set the server's IANA zone so they are
# converted to UTC correctly — most brokers on GMT+2/GMT+3 (DST) match
# Europe/Athens or Asia/Nicosia. Check: the server time in Market Watch vs UTC.
MT5_SERVER_TIMEZONE=UTC
# Seconds between checks for a newly closed bar
MT5_POLL_INTERVAL_SECONDS=1.0
# Closed bars read per check — how many missed bars a reconnect can recover.
# The recovery window is this × the timeframe: 16 bars of M15 = 4 hours.
MT5_CATCHUP_BARS=5
# false = a restart silently skips every bar that closed while it was down.
# true = those bars are published at start-up, bounded by MT5_CATCHUP_BARS.
# Turn NATS_JETSTREAM_ENABLED on with it: bars the previous process already
# sent are republished, and JetStream drops them by event_id.
MT5_BACKFILL_ON_START=false
MT5_RECONNECT_INTERVAL_SECONDS=5.0
