# ─────────────────────────────────────────────────────────────────
# App (FastAPI)
# ─────────────────────────────────────────────────────────────────
APP_NAME=algo-trading-ingester
APP_HOST=0.0.0.0
APP_PORT=8090
# Identifies this process in every event (source.ingester_id) and every
# Telegram message. Blank = the machine's hostname.
APP_INSTANCE_ID=
# Swagger /docs, /redoc and /openapi.json
APP_DOCS_ENABLED=false

# ─────────────────────────────────────────────────────────────────
# Sources — which markets this process ingests, side by side
# Each market is read from <SOURCE_CONFIG_DIR>/<market>.toml, where one
# [gateway] table per venue carries its symbols, timeframes and knobs, and
# "enable" in that table decides whether this market starts it.
#   forex  → config/forex.toml   ([mt5])
#   crypto → config/crypto.toml  ([binance])
# Any of: forex, crypto
# ─────────────────────────────────────────────────────────────────
SOURCE_MARKET=forex,crypto
SOURCE_CONFIG_DIR=config

# ─────────────────────────────────────────────────────────────────
# Payload contract — stamped as schema_version on every published event.
# Bump the major part on any breaking change to the payload shape; keep it in
# step with what qte-ingest accepts, and with examples/nats/.
# ─────────────────────────────────────────────────────────────────
SCHEMA_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ─────────────────────────────────────────────────────────────────
# NATS — publish only, the ingester never subscribes
# Subjects: <NATS_SUBJECT_PREFIX>.bar.closed.<gateway>.<symbol>.<timeframe>
#   e.g.     INGEST.bar.closed.mt5.XAUUSD.M15
# Dots and other unsafe characters in a symbol become "_" in the subject only
# (XAUUSD.m → XAUUSD_m); the JSON payload keeps the symbol verbatim.
# ─────────────────────────────────────────────────────────────────
NATS_HOST=localhost
NATS_PORT=4222
NATS_TOKEN=changeme
NATS_SUBJECT_PREFIX=INGEST
NATS_CONNECT_TIMEOUT=5.0
NATS_RECONNECT_TIME_WAIT=2.0
# false = core NATS (fire-and-forget). true = JetStream: every bar is persisted
# and de-duplicated by event_id via Nats-Msg-Id. The server must run with
# JetStream (-js). The stream is named after NATS_SUBJECT_PREFIX (first token,
# so INGEST here) and created if missing, never reconfigured — it is derived
# rather than configured so the name can never drift from the subjects it has
# to carry.
NATS_JETSTREAM_ENABLED=false
NATS_PUBLISH_TIMEOUT=5.0
NATS_STREAM_MAX_AGE_SECONDS=604800
# Must cover the span a gateway's backfill_on_start can replay, or a restart
# republishes bars the subscriber has already seen. Fixed when the stream is
# created; an existing stream is never reconfigured.
NATS_DUPLICATE_WINDOW_SECONDS=120

# ─────────────────────────────────────────────────────────────────
# Telegram — service status notifications (running / stopped / gateway
# connected / disconnected / NATS disconnected / reconnected)
# TELEGRAM_CHAT_IDS is comma-separated; append "_<topic id>" to post into a
# forum topic, e.g. "-1001111111111,-1002173777783_924584".
# ─────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_HTTP_TIMEOUT=5.0
TELEGRAM_QUEUE_SIZE=100
# Mirror every ERROR log record into its own chat, so a failure is not buried
# between the lifecycle messages. Needs TELEGRAM_ENABLED=true as well.
TELEGRAM_LOG_ERRORS_ENABLED=false
# Both fall back to TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_IDS when left blank, so
# a separate token is only needed when the error chat belongs to another bot.
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_IDS=
# Seconds an identical error is suppressed: a failing poll repeats every
# interval and would otherwise flood the chat.
TELEGRAM_LOG_DEDUP_WINDOW=60

# ─────────────────────────────────────────────────────────────────
# MetaTrader 5 terminal — credentials and local paths only.
# Everything about *what* MT5 ingests (symbols, timeframes, polling, catch-up,
# backfill, server timezone) lives in the [mt5] table of a market file, e.g.
# config/forex.toml. These stay here because they are secrets and host paths.
# ─────────────────────────────────────────────────────────────────
# Path to terminal64.exe; blank = let the MetaTrader5 package find it
MT5_TERMINAL_PATH=
# Leave LOGIN/PASSWORD/SERVER blank to use the account the terminal is logged in
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000
