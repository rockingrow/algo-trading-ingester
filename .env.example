# ─────────────────────────────────────────────────────────────────
# App (FastAPI)
# ─────────────────────────────────────────────────────────────────
APP_NAME=algo-trading-ingester
APP_HOST=0.0.0.0
APP_PORT=8090
# Identifies this process in every event (source.ingester_id) and every
# Telegram message. Blank = the machine's hostname.
APP_INSTANCE_ID=
# Swagger /docs, /redoc and /openapi.json
APP_DOCS_ENABLED=false

# ─────────────────────────────────────────────────────────────────
# Sources — which markets this process ingests, side by side
# Each market is read from <SOURCE_CONFIG_DIR>/<market>.toml, where one
# [gateway] table per venue carries its symbols, timeframes and knobs, and
# "enable" in that table decides whether this market starts it.
#   forex  → config/forex.toml   ([mt5])
#   crypto → config/crypto.toml  ([binance])
# Any of: forex, crypto
# ─────────────────────────────────────────────────────────────────
SOURCE_MARKET=forex
SOURCE_CONFIG_DIR=config

# ─────────────────────────────────────────────────────────────────
# Payload contract — stamped as schema_version on every published event.
# Bump the major part on any breaking change to the payload shape; keep it in
# step with what qte-ingest accepts, and with examples/nats/.
# ─────────────────────────────────────────────────────────────────
SCHEMA_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────────
# Logging
# DEBUG dumps every venue payload: this service has written 400 MB in a
# single day at that level. Use it to investigate, not to run.
# ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
# Mirror the log to stdout as well as to <LOG_DIR>/<YYYYMMDD>.log. Set it to
# false under a supervisor (systemd, pm2, NSSM) that already captures stdout:
# the mirror is a synchronous write on the thread that logged, so a console
# that cannot keep up holds up a gateway's poll loop.
LOG_CONSOLE=true
# Delete day files older than this, at start-up and at each midnight roll.
# 0 keeps every file forever — the right value only where something else
# rotates the directory.
LOG_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────────
# NATS — bars are published one way; history is served on request
# Subjects: <NATS_SUBJECT_PREFIX>.bar.closed.<gateway>.<symbol>.<timeframe>
#   e.g.     INGEST.bar.closed.mt5.XAUUSD.M15
# Dots and other unsafe characters in a symbol become "_" in the subject only
# (XAUUSD.m → XAUUSD_m); the JSON payload keeps the symbol verbatim.
# ─────────────────────────────────────────────────────────────────
NATS_HOST=localhost
NATS_PORT=4222
NATS_TOKEN=changeme
NATS_SUBJECT_PREFIX=INGEST
NATS_CONNECT_TIMEOUT=5.0
NATS_RECONNECT_TIME_WAIT=2.0
# Give up and stop the whole service when this many connection attempts fail
# inside NATS_GIVE_UP_WINDOW_SECONDS. An ingester that cannot reach NATS
# publishes nothing, so retrying for hours only hides the outage: it shuts
# itself down gracefully, says why on Telegram, and stays down until an
# operator starts it again (nothing restarts it automatically). One attempt is
# counted per NATS_RECONNECT_TIME_WAIT while the link is down, so at these
# defaults 300 attempts is ~10 minutes unreachable inside any half hour. A
# reconnect does not clear the count — a link that keeps flapping gives up too.
# 0 = never give up (retry for as long as the process runs).
NATS_GIVE_UP_AFTER_ATTEMPTS=300
NATS_GIVE_UP_WINDOW_SECONDS=1800
# false = core NATS (fire-and-forget). true = JetStream: every bar is persisted
# and de-duplicated by event_id via Nats-Msg-Id. The server must run with
# JetStream (-js). The stream is named after NATS_SUBJECT_PREFIX (first token,
# so INGEST here) and created if missing, never reconfigured — it is derived
# rather than configured so the name can never drift from the subjects it has
# to carry.
NATS_JETSTREAM_ENABLED=false
NATS_PUBLISH_TIMEOUT=5.0
NATS_STREAM_MAX_AGE_SECONDS=604800
# Must cover the span a gateway re-reads after an outage (recovery_bars × the
# timeframe), or a recovered bar is stored twice. Fixed when the stream is
# created; an existing stream is never reconfigured.
NATS_DUPLICATE_WINDOW_SECONDS=120
# History requests: a subscriber asks on
#   <prefix>.history.<gateway>.<symbol>.<timeframe>   e.g. INGEST_RPC.history.mt5.XAUUSD.M15
# with {"symbol", "timeframe", "count"} and gets the newest closed bars back
# in one reply. It rides the connection above — nothing inbound is opened.
# Blank = <NATS_SUBJECT_PREFIX>_RPC. It must NOT sit under NATS_SUBJECT_PREFIX:
# the JetStream stream listens on <NATS_SUBJECT_PREFIX>.> and would capture
# every request, so that is refused at start-up.
NATS_RPC_SUBJECT_PREFIX=
# Most bars one request is answered with, whatever it asks for. A reply is one
# NATS message, so the server's max_payload bounds it too; either way the
# newest bars are kept and the reply says truncated.
NATS_HISTORY_MAX_BARS=5000
# Seconds a gateway may take to read the bars for one request.
NATS_HISTORY_TIMEOUT=20.0

# ─────────────────────────────────────────────────────────────────
# Telegram — service status notifications (running / stopped / gateway
# connected / disconnected / NATS disconnected / reconnected)
# TELEGRAM_CHAT_IDS is comma-separated; append "_<topic id>" to post into a
# forum topic, e.g. "-1001111111111,-1002173777783_924584".
# ─────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_HTTP_TIMEOUT=5.0
TELEGRAM_QUEUE_SIZE=100
# Mirror every ERROR log record into its own chat, so a failure is not buried
# between the lifecycle messages. Needs TELEGRAM_ENABLED=true as well.
TELEGRAM_LOG_ERRORS_ENABLED=false
# Both fall back to TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_IDS when left blank, so
# a separate token is only needed when the error chat belongs to another bot.
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_IDS=
# Seconds one log statement is suppressed after its first message. Keyed on the
# statement, not on the text: a failure that repeats per bar carries a new
# event id every time and would otherwise flood the chat. The next message
# through says how many were suppressed.
TELEGRAM_LOG_DEDUP_WINDOW=60

# ─────────────────────────────────────────────────────────────────
# MetaTrader 5 terminal — credentials and local paths only.
# Everything about *what* MT5 ingests (symbols, timeframes, polling, outage
# recovery, server timezone) lives in the [mt5] table of a market file, e.g.
# config/forex.toml. These stay here because they are secrets and host paths.
# ─────────────────────────────────────────────────────────────────
# Path to terminal64.exe; blank = let the MetaTrader5 package find it
MT5_TERMINAL_PATH=
# Leave LOGIN/PASSWORD/SERVER blank to use the account the terminal is logged in
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000
